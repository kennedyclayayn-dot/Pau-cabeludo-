--// --- LÓGICA DE TELEPORTE ---
local function atualizarLista()
    for _, child in ipairs(ListaFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for i, pos in ipairs(posicoesSalvas) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = pos.name
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 14
        btn.Parent = ListaFrame
        
        btn.MouseButton1Click:Connect(function()
            posicaoSelecionada = i
            for _, b in ipairs(ListaFrame:GetChildren()) do
                if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(60, 60, 60) end
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        end)
    end
end

BotaoSalvar.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        table.insert(posicoesSalvas, {name = "Posição " .. (#posicoesSalvas + 1), cframe = char.HumanoidRootPart.CFrame})
        atualizarLista()
    end
end)

BotaoTeleportar.MouseButton1Click:Connect(function()
    if not posicaoSelecionada then return end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = posicoesSalvas[posicaoSelecionada].cframe
    end
end)

BotaoDeletar.MouseButton1Click:Connect(function()
    if not posicaoSelecionada then return end
    table.remove(posicoesSalvas, posicaoSelecionada)
    posicaoSelecionada = nil
    atualizarLista()
end)

BotaoConfirmarNome.MouseButton1Click:Connect(function()
    if not posicaoSelecionada or TextBoxRenomear.Text == "" then return end
    posicoesSalvas[posicaoSelecionada].name = TextBoxRenomear.Text
    TextBoxRenomear.Text = ""
    atualizarLista()
end)

--// --- LÓGICA DO NOCLIP ---
local function alternarNoclip()
    noclipAtivo = not noclipAtivo
    if noclipAtivo then
        BotaoNoclip.Text = "👻 Noclip: ON"
        BotaoNoclip.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        conexaoNoclip = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    else
        BotaoNoclip.Text = "👻 Noclip: OFF"
        BotaoNoclip.BackgroundColor3 = Color3.fromRGB(100, 50, 50)
        if conexaoNoclip then conexaoNoclip:Disconnect() conexaoNoclip = nil end
        if LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
            end
        end
    end
end
BotaoNoclip.MouseButton1Click:Connect(alternarNoclip)

