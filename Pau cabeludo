-- Função para criar Sliders
local function criarSlider(parent, y, nome, min, max, padrao, callback)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -20, 0, 30)
    bg.Position = UDim2.new(0, 10, 0, y)
    bg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    bg.BorderSizePixel = 0
    bg.Parent = parent

    local barra = Instance.new("Frame")
    barra.Size = UDim2.new(1, -20, 0, 4)
    barra.Position = UDim2.new(0, 10, 0.5, -2)
    barra.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    barra.BorderSizePixel = 0
    barra.Parent = bg

    local preenchimento = Instance.new("Frame")
    preenchimento.Size = UDim2.new(0, 0, 1, 0)
    preenchimento.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    preenchimento.BorderSizePixel = 0
    preenchimento.Parent = barra

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new(0, 0, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.Parent = barra

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Text = nome .. ": " .. padrao
    label.Font = Enum.Font.SourceSans
    label.TextSize = 12
    label.Parent = bg

    local dragging = false
    local function atualizar(valor)
        valor = math.clamp(valor, min, max)
        local percent = (valor - min) / (max - min)
        knob.Position = UDim2.new(percent, -9, 0.5, -9)
        preenchimento.Size = UDim2.new(percent, 0, 1, 0)
        label.Text = nome .. ": " .. valor
        callback(valor)
    end

    atualizar(padrao)

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    barra.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local mouseX = input.Position.X
            local bgX = barra.AbsolutePosition.X
            local bgW = barra.AbsoluteSize.X
            atualizar(math.floor(min + (max - min) * math.clamp((mouseX - bgX) / bgW, 0, 1)))
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mouseX = input.Position.X
            local bgX = barra.AbsolutePosition.X
            local bgW = barra.AbsoluteSize.X
            atualizar(math.floor(min + (max - min) * math.clamp((mouseX - bgX) / bgW, 0, 1)))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

